# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BOT MINECRAFT RPG
# ==========================================

# 1. Token của Bot Discord (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# 2. Client ID của Bot (Lấy từ Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# 3. ID Discord của Admin Bot (Có thể nhập nhiều ID, cách nhau bởi dấu phẩy)
ADMIN_IDS=your_discord_user_id

# 4. Thư mục lưu trữ dữ liệu (Trên Railway khi gắn Volume mount vào /app/data, hãy đặt là /app/data)
# Nếu chạy ở máy tính cá nhân local, có thể để trống hoặc comment lại.
DATA_DIR=/app/data
